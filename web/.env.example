# --- Supabase (https://supabase.com/dashboard) ---
# Public, browser-safe. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# Server-only. NEVER expose to the browser. Service role bypasses RLS — use sparingly.
# Required only for admin tasks (e.g. user invites, manual DB writes from server actions).
# Leave unset if you do not need it; the build does not require it.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# --- App ---
# Base URL used for OAuth redirect construction. In Vercel, set this to your production
# URL. For local dev, use http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: comma-separated log levels. Defaults to "info,error".
LOG_LEVELS=info,error
